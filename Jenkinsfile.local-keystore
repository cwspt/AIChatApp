// Local Jenkins release pipeline for AIChatApp.
// This app has no external shared-client module, so shared-client validation is intentionally omitted.
def APP_CONFIG = [
  appName    : 'AIChatApp',
  repoDir    : 'D:\\Projects\\Personal\\AI\\AIChatApp',
  appModule  : 'app',
  versionFile: 'app\\build.gradle.kts',
  apkRelPath : 'app\\build\\outputs\\apk\\release\\app-release.apk'
]

// Keep shared Android tooling in one place for all sibling apps.
def SHARED_CONFIG = [
  workspaceRoot : 'D:\\Projects\\Personal',
  androidRoot   : 'D:\\Projects\\Personal\\.devtools\\android',
  jdkRoot       : 'D:\\Projects\\Personal\\.devtools\\android\\jdk',
  downloadsRoot : 'D:\\Projects\\Personal\\.devtools\\android\\downloads',
  sdkRoot       : 'D:\\Projects\\Personal\\.devtools\\android\\sdk',
  gradleUserHome: 'D:\\Projects\\Personal\\.gradle-user-home',
  gradleZipPath : 'D:\\Projects\\Personal\\.devtools\\android\\downloads\\gradle-8.7-bin.zip'
]

def DEFAULT_ANDROID_USER_HOME = "${APP_CONFIG.repoDir}\\.android-user-home"
def EXPECTED_SHARED_GRADLE_DISTRIBUTION_URL = "file:///${SHARED_CONFIG.gradleZipPath.replace('\\', '/')}"

def psUtf8(String scriptText) {
  powershell """
    \$ErrorActionPreference = 'Stop'
    [Console]::InputEncoding = [System.Text.UTF8Encoding]::new(\$false)
    [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(\$false)
    \$OutputEncoding = [System.Text.UTF8Encoding]::new(\$false)
    chcp 65001 > \$null

${scriptText}
  """
}

pipeline {
  agent {
    node {
      label ''
      customWorkspace "${APP_CONFIG.repoDir}"
    }
  }

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    string(name: 'BUILD_BRANCH', defaultValue: '', description: '本地要构建的分支，留空则使用当前分支')
    booleanParam(name: 'BUMP_VERSION', defaultValue: true, description: '是否自动提升版本号')
    booleanParam(name: 'COMMIT_VERSION_BUMP_LOCAL', defaultValue: false, description: '是否将版本号改动提交到本地 git（不 push）')
  }

  environment {
    APP_NAME = "${APP_CONFIG.appName}"
    REPO_DIR = "${APP_CONFIG.repoDir}"
    APP_MODULE = "${APP_CONFIG.appModule}"
    VERSION_FILE_REL = "${APP_CONFIG.versionFile}"
    APK_REL_PATH = "${APP_CONFIG.apkRelPath}"

    WORKSPACE_ROOT = "${SHARED_CONFIG.workspaceRoot}"
    SHARED_ANDROID_ROOT = "${SHARED_CONFIG.androidRoot}"
    SHARED_JDK_ROOT = "${SHARED_CONFIG.jdkRoot}"
    SHARED_DOWNLOADS_ROOT = "${SHARED_CONFIG.downloadsRoot}"
    SHARED_GRADLE_ZIP = "${SHARED_CONFIG.gradleZipPath}"
    SHARED_GRADLE_DISTRIBUTION_URL = "${EXPECTED_SHARED_GRADLE_DISTRIBUTION_URL}"
    ANDROID_SDK_ROOT = "${SHARED_CONFIG.sdkRoot}"
    ANDROID_HOME = "${SHARED_CONFIG.sdkRoot}"
    ANDROID_USER_HOME = "${DEFAULT_ANDROID_USER_HOME}"
    GRADLE_USER_HOME = "${SHARED_CONFIG.gradleUserHome}"
  }

  stages {
    stage('Trust Local Repo') {
      steps {
        script {
          psUtf8 '''
            git config --global --add safe.directory "$env:REPO_DIR"
            Write-Host "已加入 safe.directory:"
            git config --global --get-all safe.directory
          '''
        }
      }
    }

    stage('Resolve Shared Android Env') {
      steps {
        script {
          env.JAVA_HOME = powershell(returnStdout: true, script: '''
            $ErrorActionPreference = 'Stop'
            [Console]::InputEncoding = [System.Text.UTF8Encoding]::new($false)
            [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
            $OutputEncoding = [System.Text.UTF8Encoding]::new($false)
            chcp 65001 > $null

            $jdkRoot = $env:SHARED_JDK_ROOT
            $sdkRoot = $env:ANDROID_SDK_ROOT
            $downloadsRoot = $env:SHARED_DOWNLOADS_ROOT
            $gradleZip = $env:SHARED_GRADLE_ZIP
            $androidUserHome = $env:ANDROID_USER_HOME
            $gradleUserHome = $env:GRADLE_USER_HOME

            if (!(Test-Path -LiteralPath $jdkRoot)) {
              throw "共享 JDK 根目录不存在：$jdkRoot"
            }

            if (!(Test-Path -LiteralPath $sdkRoot)) {
              throw "共享 Android SDK 不存在：$sdkRoot"
            }

            if (!(Test-Path -LiteralPath $downloadsRoot)) {
              throw "共享下载目录不存在：$downloadsRoot"
            }

            if (!(Test-Path -LiteralPath $gradleZip)) {
              throw "共享 Gradle 分发包不存在：$gradleZip"
            }

            New-Item -ItemType Directory -Force -Path $androidUserHome | Out-Null
            New-Item -ItemType Directory -Force -Path $gradleUserHome | Out-Null

            $javaHome = Get-ChildItem -LiteralPath $jdkRoot -Directory |
              Where-Object { Test-Path -LiteralPath (Join-Path $_.FullName 'bin\\java.exe') } |
              Select-Object -First 1 -ExpandProperty FullName

            if (-not $javaHome) {
              if (Test-Path -LiteralPath (Join-Path $jdkRoot 'bin\\java.exe')) {
                $javaHome = $jdkRoot
              } else {
                throw "未在共享 JDK 根目录下找到可用的 java.exe：$jdkRoot"
              }
            }

            Write-Output $javaHome
          ''').trim()

          echo "APP_NAME=${env.APP_NAME}"
          echo "REPO_DIR=${env.REPO_DIR}"
          echo "APP_MODULE=${env.APP_MODULE}"
          echo "JAVA_HOME=${env.JAVA_HOME}"
          echo "ANDROID_SDK_ROOT=${env.ANDROID_SDK_ROOT}"
          echo "ANDROID_HOME=${env.ANDROID_HOME}"
          echo "ANDROID_USER_HOME=${env.ANDROID_USER_HOME}"
          echo "GRADLE_USER_HOME=${env.GRADLE_USER_HOME}"
        }
      }
    }

    stage('Repo Info') {
      steps {
        script {
          psUtf8 '''
            if (!(Test-Path ".git")) {
              throw "当前目录不是 git 仓库：$PWD"
            }

            Write-Host "应用名称: $env:APP_NAME"
            Write-Host "工作目录: $PWD"
            Write-Host "当前状态:"
            git status --short

            if ($env:BUILD_BRANCH -and $env:BUILD_BRANCH.Trim() -ne "") {
              git checkout $env:BUILD_BRANCH
            }

            Write-Host "当前分支:"
            git branch --show-current

            Write-Host "当前提交:"
            git rev-parse --short HEAD
          '''
        }
      }
    }

    stage('Validate Project') {
      steps {
        script {
          psUtf8 '''
            $wrapperProperties = Join-Path $PWD "gradle\\wrapper\\gradle-wrapper.properties"
            if (!(Test-Path -LiteralPath $wrapperProperties)) {
              throw "未找到 Gradle wrapper 配置：$wrapperProperties"
            }

            $wrapperContent = Get-Content -LiteralPath $wrapperProperties -Raw -Encoding UTF8
            if ($wrapperContent -notmatch [regex]::Escape($env:SHARED_GRADLE_DISTRIBUTION_URL)) {
              throw "当前 wrapper 未指向共享 Gradle 本地分发包，请先同步 gradle-wrapper.properties"
            }

            $settingsFile = Join-Path $PWD "settings.gradle.kts"
            if (!(Test-Path -LiteralPath $settingsFile)) {
              throw "未找到 settings.gradle.kts：$settingsFile"
            }

            $settingsContent = Get-Content -LiteralPath $settingsFile -Raw -Encoding UTF8
            if ($settingsContent -notmatch 'include\\(":app"\\)') {
              throw "settings.gradle.kts 未包含 :app 模块"
            }

            $versionFile = Join-Path $PWD $env:VERSION_FILE_REL
            if (!(Test-Path -LiteralPath $versionFile)) {
              throw "未找到版本文件：$versionFile"
            }

            Write-Host "AIChatApp 项目与本地 Gradle 分发包已就绪"
          '''
        }
      }
    }

    stage('Validate Local Signing') {
      steps {
        script {
          psUtf8 '''
            $propertiesPath = Join-Path $PWD "keystore.properties"
            if (!(Test-Path $propertiesPath)) {
              throw "未找到本地 release 签名配置：$propertiesPath。请在 AIChatApp 仓库根目录创建不提交到 git 的 keystore.properties。"
            }

            $props = @{}
            Get-Content -LiteralPath $propertiesPath -Encoding UTF8 | ForEach-Object {
              $line = $_.Trim()
              if ([string]::IsNullOrWhiteSpace($line) -or $line.StartsWith("#")) {
                return
              }

              $pair = $line -split '=', 2
              if ($pair.Count -eq 2) {
                $props[$pair[0].Trim()] = $pair[1].Trim()
              }
            }

            $requiredKeys = @(
              "release.storeFile",
              "release.storePassword",
              "release.keyAlias",
              "release.keyPassword"
            )

            foreach ($key in $requiredKeys) {
              if (-not $props.ContainsKey($key) -or [string]::IsNullOrWhiteSpace($props[$key])) {
                throw "keystore.properties 缺少配置项：$key"
              }
            }

            $storeFile = $props["release.storeFile"]
            if (-not [System.IO.Path]::IsPathRooted($storeFile)) {
              $storeFile = Join-Path $PWD $storeFile
            }

            if (!(Test-Path $storeFile)) {
              throw "release keystore 文件不存在：$storeFile"
            }

            Write-Host "已检测到本地 release 签名配置"
            Write-Host "release.storeFile: $storeFile"
            Write-Host "release.keyAlias: $($props["release.keyAlias"])"
          '''
        }
      }
    }

    stage('Bump Version') {
      when {
        expression { return params.BUMP_VERSION }
      }
      steps {
        script {
          psUtf8 '''
            $file = $env:VERSION_FILE_REL
            $content = Get-Content -LiteralPath $file -Raw -Encoding UTF8

            $versionCodeMatch = [regex]::Match($content, 'versionCode\\s*=\\s*(\\d+)')
            if (-not $versionCodeMatch.Success) {
              throw "未找到 versionCode"
            }

            $oldCode = [int]$versionCodeMatch.Groups[1].Value
            $newCode = $oldCode + 1
            $content = [regex]::Replace(
              $content,
              'versionCode\\s*=\\s*\\d+',
              "versionCode = $newCode",
              1
            )

            $versionNameMatch = [regex]::Match($content, 'versionName\\s*=\\s*"([0-9]+)\\.([0-9]+)\\.([0-9]+)"')
            if (-not $versionNameMatch.Success) {
              throw "未找到三段式 versionName"
            }

            $major = [int]$versionNameMatch.Groups[1].Value
            $minor = [int]$versionNameMatch.Groups[2].Value
            $patch = [int]$versionNameMatch.Groups[3].Value + 1
            $newVersion = "$major.$minor.$patch"

            $content = [regex]::Replace(
              $content,
              'versionName\\s*=\\s*"[0-9]+\\.[0-9]+\\.[0-9]+"',
              "versionName = `"$newVersion`"",
              1
            )

            Set-Content -LiteralPath $file -Value $content -Encoding UTF8

            Write-Host "版本已提升:"
            Write-Host "versionCode: $oldCode -> $newCode"
            Write-Host "versionName: $newVersion"
          '''
        }
      }
    }

    stage('Build Release') {
      steps {
        bat '@chcp 65001>nul && echo APP_NAME=%APP_NAME%'
        bat '@chcp 65001>nul && echo REPO_DIR=%REPO_DIR%'
        bat '@chcp 65001>nul && echo APP_MODULE=%APP_MODULE%'
        bat '@chcp 65001>nul && echo JAVA_HOME=%JAVA_HOME%'
        bat '@chcp 65001>nul && echo ANDROID_SDK_ROOT=%ANDROID_SDK_ROOT%'
        bat '@chcp 65001>nul && echo ANDROID_HOME=%ANDROID_HOME%'
        bat '@chcp 65001>nul && echo ANDROID_USER_HOME=%ANDROID_USER_HOME%'
        bat '@chcp 65001>nul && echo GRADLE_USER_HOME=%GRADLE_USER_HOME%'

        bat '@chcp 65001>nul && gradlew.bat --stop'
        bat '@chcp 65001>nul && gradlew.bat :%APP_MODULE%:clean :%APP_MODULE%:assembleRelease --console=plain --no-daemon'
      }
    }

    stage('Archive APK') {
      steps {
        archiveArtifacts artifacts: "${env.APK_REL_PATH}", fingerprint: true
        script {
          psUtf8 '''
            $apk = Get-Item -LiteralPath $env:APK_REL_PATH
            Write-Host "APK 路径: $($apk.FullName)"
            Write-Host "APK 大小: $($apk.Length)"
            Write-Host "生成时间: $($apk.LastWriteTime)"
          '''
        }
      }
    }

    stage('Commit Version Locally') {
      when {
        allOf {
          expression { return params.BUMP_VERSION }
          expression { return params.COMMIT_VERSION_BUMP_LOCAL }
        }
      }
      steps {
        script {
          psUtf8 '''
            git config user.name "Jenkins"
            git config user.email "jenkins@local"

            git add $env:VERSION_FILE_REL
            git commit -m "chore: bump version after Jenkins local release build" 2>$null

            if ($LASTEXITCODE -ne 0) {
              Write-Host "没有可提交的版本变更"
              exit 0
            }

            Write-Host "版本号已提交到本地仓库，但没有 push"
          '''
        }
      }
    }
  }

  post {
    success {
      echo "${env.APP_NAME} 本地 keystore 版 release 构建成功"
    }

    failure {
      echo "${env.APP_NAME} 本地 keystore 版 release 构建失败，请查看 Jenkins 控制台日志"
    }
  }
}
